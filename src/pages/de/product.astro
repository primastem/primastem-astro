---
// Components
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/ui/Section.astro'
import Row from '../../components/ui/Row.astro'
import Col from '../../components/ui/Col.astro'
import { Image } from 'astro:assets'
import Button from '../../components/ui/Button.astro'
import BasicCard from '../../components/ui/cards/BasicCard.astro'
import Card from '../../components/ui/cards/partials/Card.astro'
import CardBody from '../../components/ui/cards/partials/CardBody.astro'
import TextImage from '../../components/blocks/basic/TextImage.astro'

// Assets
import heroImage from '../../assets/hero-primastem.jpg'
import mapsImage from '../../assets/maps-on-grid.jpg'
import lessonSceneImage from '../../assets/board-on-map.jpg'
import boardImage from '../../assets/board-3d.jpg'
import robotOnMapImage from '../../assets/robot-on-map.jpg'
import pentagonImg from '../../assets/drawings/drawing-pentagon.png'
import starImg from '../../assets/drawings/drawing-star.png'
import spiralImg from '../../assets/drawings/drawing-spiral-shape.png'
import heartImg from '../../assets/drawings/drawing-heart.png'

// Content (CMS-editable)
import pageData from '../../content/pages/de/product.json'

const { seo, hero, twoLevels, drawing, lessons, health, maps, voiceFeedback, openPlatform, kit, specs, documentation, order } = pageData
const prefix = `/${Astro.currentLocale ?? 'de'}`

const drawingImages = [pentagonImg, starImg, spiralImg, heartImg]
---

<Layout title={seo.title} description={seo.description}>
	<script slot="structured-data" type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Product",
		"name": "PrimaSTEM Educational Robot Kit",
		"description": "Screen-free coding and mathematics for ages 4–10. Wooden programmable robot with NFC command tokens.",
		"brand": { "@type": "Brand", "name": "PrimaSTEM" },
		"manufacturer": { "@type": "Organization", "name": "PrimaSTEM SAS" },
		"material": "Wood",
		"audience": { "@type": "EducationalAudience", "educationalRole": "student", "suggestedMinAge": "4", "suggestedMaxAge": "10" },
		"offers": {
			"@type": "Offer",
			"availability": "https://schema.org/InStock",
			"businessFunction": "http://purl.org/goodrelations/v1#Sell",
			"url": "https://primastem.com/contact",
			"seller": { "@type": "Organization", "name": "PrimaSTEM" }
		}
	})} />

	<!-- ЭТАЖ 1: РАССКАЗ -->

	<!-- 1a. POSITIONING (wedge) -->
	<Section id="product-positioning" padding="both">
		<Row>
			<Col span="12" align="center">
				<h1 set:html={hero.headline} />
				{hero.lead && <p class="text-lg max-w-3xl mx-auto" set:html={hero.lead} />}
			</Col>
		</Row>
	</Section>

	<!-- 1b. HOW IT WORKS: video + steps + lock + simulator -->
	<Section id="product-hero" padding="both" classes="bg-neutral-50 dark:bg-neutral-900">
		<Row>
			<Col span="5" align="start">
				<h2 set:html={hero.title} />
				<div class="space-y-4">
					{
						hero.steps.map((step) => (
							<div class="flex gap-3">
								<span class="flex-shrink-0 w-8 h-8 rounded-full bg-primary-500 text-white flex items-center justify-center font-bold">{step.number}</span>
								<p>{step.text}</p>
							</div>
						))
					}
				</div>
			</Col>
			<Col span="7">
				<div class="aspect-video rounded-xl overflow-hidden" role="region" aria-label="PrimaSTEM product demo video">
					<iframe
						src={hero.videoUrl}
						title="PrimaSTEM demo"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
						allowfullscreen
						loading="lazy"
						class="w-full h-full"
					></iframe>
				</div>
				<p class="text-sm text-neutral-500 dark:text-neutral-400 text-center mt-4 italic">{hero.videoCaption}</p>
			</Col>
		</Row>
		<Row>
			<Col span="12">
				<Card classes="mt-8 !bg-neutral-100 !shadow-none dark:!bg-neutral-800 dark:!text-neutral-400 border border-neutral-200 dark:border-neutral-700 text-center">
					<CardBody>
						{hero.lock.map((line, i) => (
							<p class={i === hero.lock.length - 1 ? 'pb-0' : 'pb-2'}>{line}</p>
						))}
					</CardBody>
				</Card>
				<p class="mt-6 pb-0 text-center" set:html={hero.simulatorLine} />
			</Col>
		</Row>
	</Section>

	<!-- 2. TWO LEVELS (рамка) -->
	<Section id="two-levels" padding="both">
		<Row>
			<Col span="12" align="center" classes="mb-8">
				<h2 set:html={twoLevels.title} />
			</Col>
		</Row>
		<Row>
			{
				twoLevels.levels.map((level) => (
					<Col span="6">
						<Card classes="!bg-neutral-50 !shadow-none dark:!bg-neutral-900 dark:!text-neutral-400 h-full border border-neutral-100 dark:border-neutral-800">
							<CardBody>
								<h3 class="text-xl">{level.heading}</h3>
								{level.paragraphs.map((p) => (
									<p set:html={p} />
								))}
							</CardBody>
						</Card>
					</Col>
				))
			}
		</Row>
		<Row>
			<Col span="12" align="center" classes="mt-4">
				<p class="pb-0" set:html={twoLevels.scratchLine} />
			</Col>
		</Row>
	</Section>

	<!-- 3. DRAWING FINALE -->
	<Section id="drawing" padding="both" classes="bg-neutral-50 dark:bg-neutral-900">
		<Row>
			<Col span="12" align="center" classes="mb-6">
				<h2 set:html={drawing.title} />
				<p class="text-lg max-w-3xl mx-auto">{drawing.intro}</p>
			</Col>
		</Row>
		<Row>
			{
				drawing.drawings.map((item, i) => (
					<Col span="3">
						<figure class="text-center">
							<Image
								src={drawingImages[i]}
								alt={`Рисунок робота: ${item.name}`}
								class="rounded-xl w-full aspect-square object-contain bg-white"
								format="webp"
							/>
							<figcaption class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">{item.name}</figcaption>
						</figure>
					</Col>
				))
			}
		</Row>
		<Row>
			<Col span="12" align="center" classes="mt-6">
				{
					drawing.afterGallery.map((p, i) => (
						<p class={i === drawing.afterGallery.length - 1 ? 'text-lg pb-0 max-w-3xl mx-auto' : 'text-lg max-w-3xl mx-auto'} set:html={p} />
					))
				}
			</Col>
		</Row>
	</Section>

	<!-- ЭТАЖ 2: СПРАВОЧНИК -->

	<!-- 4. LESSONS -->
	<Section id="lessons" padding="both">
		<Row>
			<Col span="9" align="start">
				<h2>{lessons.title}</h2>
				{
					lessons.paragraphs.map((p, i) => (
						<p class={i === lessons.paragraphs.length - 1 ? 'text-lg pb-0' : 'text-lg'} set:html={p} />
					))
				}
				<div class="mt-6">
					<Button size="lg" style="secondary" link={lessons.buttonLink}>{lessons.buttonText}</Button>
				</div>
			</Col>
			<Col span="3" align="center" classes="flex items-center justify-center">
				<Image
					src={lessonSceneImage}
					alt="Занятие с PrimaSTEM: игровое поле, пульт с программой и фишки"
					class="rounded-xl max-h-[24rem] w-auto mx-auto object-contain lg:max-h-none lg:w-full lg:object-cover lg:aspect-[3/4]"
					format="webp"
				/>
			</Col>
		</Row>
	</Section>

	<!-- 4b. HEALTH: screen-free fact, no promises -->
	<Section id="health" padding="both" classes="bg-neutral-50 dark:bg-neutral-900">
		<Row>
			<Col span="12" align="center">
				<h2>{health.title}</h2>
				{
					health.paragraphs.map((p, i) => (
						<p class={i === health.paragraphs.length - 1 ? 'text-lg pb-0 max-w-3xl mx-auto' : 'text-lg max-w-3xl mx-auto'}>{p}</p>
					))
				}
			</Col>
		</Row>
	</Section>

	<!-- 5. MAPS -->
	<TextImage
		title={maps.title}
		text={maps.text}
		image={mapsImage}
		mobileImage={mapsImage}
		imagePosition="left"
	/>

	<!-- 6. VOICE FEEDBACK -->
	<Section id="voice-feedback" padding="both" classes="bg-neutral-50 dark:bg-neutral-900">
		<Row>
			<Col span="9" align="start">
				<h2 set:html={voiceFeedback.title} />
				{
					voiceFeedback.paragraphs.map((p, i) => (
						<p class={i === voiceFeedback.paragraphs.length - 1 ? 'text-lg pb-0' : 'text-lg'}>{p}</p>
					))
				}
			</Col>
			<Col span="3" align="center" classes="flex items-center justify-center">
				<Image
					src={boardImage}
					alt="Пульт управления PrimaSTEM с фишками в ячейках"
					class="rounded-xl max-h-[24rem] w-auto mx-auto object-contain lg:max-h-none lg:w-full lg:object-cover lg:aspect-[3/4]"
					format="webp"
				/>
			</Col>
		</Row>
	</Section>

	<!-- 7. OPEN PLATFORM -->
	<Section id="open-platform" padding="both">
		<Row>
			<Col span="3" align="center" classes="flex items-center justify-center order-2 lg:order-1">
				<Image
					src={robotOnMapImage}
					alt="Робот PrimaSTEM на игровом поле среди фишек"
					class="rounded-xl max-h-[24rem] w-auto mx-auto object-contain lg:max-h-none lg:w-full lg:object-cover lg:aspect-[3/4]"
					format="webp"
				/>
			</Col>
			<Col span="9" align="start" classes="order-1 lg:order-2">
				<h2 set:html={openPlatform.title} />
				{
					openPlatform.paragraphs.map((p, i) => (
						<p class={i === openPlatform.paragraphs.length - 1 ? 'text-lg pb-0' : 'text-lg'} set:html={p} />
					))
				}
			</Col>
		</Row>
	</Section>

	<!-- 8. WHAT'S IN THE KIT -->
	<Section id="whats-included" padding="both" classes="bg-neutral-50 dark:bg-neutral-900">
		<Row>
			<Col span="12" align="center" classes="mb-12">
				<h2 set:html={kit.title} />
			</Col>
		</Row>
		<Row>
			<Col span="6" classes="grid grid-cols-2 gap-6">
				{
					kit.cards.map((card) => (
						<BasicCard title={card.title} icon={card.icon}>
							<ul class="text-sm space-y-1 list-disc list-inside">
								{card.items.map((item) => <li set:html={item} />)}
							</ul>
						</BasicCard>
					))
				}
			</Col>
			<Col span="6" classes="flex items-center justify-center">
				<Image
					src={heroImage}
					alt="Комплект PrimaSTEM: деревянный пульт с цветными фишками команд, робот-божья коровка и рисунки"
					class="rounded-xl max-h-[28rem] w-auto object-contain"
					format="webp"
				/>
			</Col>
		</Row>
	</Section>

	<!-- 9. SPECS (вобрали в себя распущенный блок «Команды») -->
	<Section id="specs" padding="both">
		<Row>
			<Col span="12" align="center">
				<h2>{specs.title}</h2>
				<div class="mt-6 mx-auto max-w-3xl rounded-xl border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-800 p-8">
					<table class="w-full text-left text-base">
						<tbody class="divide-y divide-neutral-200 dark:divide-neutral-700">
							{
								specs.rows.map((row) => (
									<tr><td class="py-3 pr-6 font-medium">{row.label}</td><td class="py-3">{row.value}</td></tr>
								))
							}
						</tbody>
					</table>
				</div>
			</Col>
		</Row>
	</Section>

	<!-- 10. DOCUMENTATION -->
	<Section id="docs-v1" padding="both" classes="bg-neutral-50 dark:bg-neutral-900">
		<Row>
			<Col span="12" align="center" classes="mb-12">
				<h2>{documentation.title}</h2>
			</Col>
		</Row>
		<Row>
			{
				documentation.cards.map((card) => (
					<Col span="3">
						<BasicCard title={card.title} subtitle={card.subtitle} icon={card.icon} link={card.link} />
					</Col>
				))
			}
		</Row>
	</Section>

	<!-- 12. ORDER -->
	<Section id="order-v1" padding="both" classes="bg-neutral-900 text-white dark:bg-neutral-800">
		<Row>
			<Col span="12" align="center">
				<h2 class="text-white dark:text-white" set:html={order.title} />
				{order.subtitle && <p class="text-lg text-neutral-300">{order.subtitle}</p>}
				{order.contactLine && <p class="text-neutral-400" set:html={order.contactLine} />}
				{order.sheetLine && <p class="text-neutral-400 mt-2" set:html={order.sheetLine} />}
				<div class="mt-6 flex justify-center gap-4 flex-wrap">
					<Button size="lg" link={prefix + order.whereToBuyLink}>{order.whereToBuyText}</Button>
					<Button size="lg" style="neutral" link="https://simulator.primastem.com/">{order.simulatorText}</Button>
				</div>
			</Col>
		</Row>
	</Section>
</Layout>
