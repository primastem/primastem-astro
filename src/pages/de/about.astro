---
// Components
import Layout from '../../layouts/Layout.astro'
import AboutSections from '../../components/blocks/AboutSections.astro'
import Hero from '../../components/blocks/hero/PageHeader.astro'
import ContactCTA from '../../components/blocks/CTA/ContactCTA.astro'

// Content (CMS-editable)
import pageData from '../../content/pages/de/about.json'

const { seo, hero, sections } = pageData
---

<Layout title={seo.title} description={seo.description}>
	<Hero title={hero.title} text={hero.text} />
	<AboutSections sections={sections} />
	<ContactCTA />
</Layout>
