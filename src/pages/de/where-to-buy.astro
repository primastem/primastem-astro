---
// Components
// - Layout
import Layout from '../../layouts/Layout.astro'
// - UI
import Hero from '../../components/blocks/hero/PageHeader.astro'
import Section from '../../components/ui/Section.astro'
import Row from '../../components/ui/Row.astro'
import Col from '../../components/ui/Col.astro'
import Card from '../../components/ui/cards/partials/Card.astro'
import CardBody from '../../components/ui/cards/partials/CardBody.astro'
import Button from '../../components/ui/Button.astro'

// Data
import pageData from '../../content/pages/de/where-to-buy.json'
const { seo, header, countries, directOrder, distributorCta } = pageData

// Distributors with "hidden": true stay in the JSON (for later editing) but are not shown;
// a country with no visible distributors is skipped.
const visibleCountries = countries
	.map((country) => ({ ...country, distributors: country.distributors.filter((d) => !('hidden' in d && d.hidden)) }))
	.filter((country) => country.distributors.length > 0)
const prefix = `/${Astro.currentLocale ?? 'de'}`
---

<Layout title={seo.title} description={seo.description}>
	<Hero title={header.title} text={header.text} />

	{
		visibleCountries.map((country) => (
			<Section padding="top">
				<Row>
					<Col span="12" align="center" classes="mb-12">
						<h2>{country.name}</h2>
					</Col>
				</Row>
				<Row>
					{country.distributors.map((d) => (
						<Col span="4" classes={country.distributors.length === 1 ? 'lg:col-start-5' : ''}>
							<Card
								link={d.url}
								classes="!bg-neutral-50 !shadow-none dark:!bg-neutral-900 h-full border border-neutral-100 dark:border-neutral-800 transition-colors hover:border-primary-500 dark:hover:border-primary-500"
							>
								<CardBody>
									<h3 class="text-xl">{d.name}</h3>
									<span class="text-primary-700 dark:text-primary-500 font-medium">{d.urlLabel}</span>
									{'note' in d && d.note && (
										<span class={`mt-3 block w-fit rounded-full px-3 py-1 text-sm font-semibold ${'noteAccent' in d && d.noteAccent ? 'bg-primary-100 dark:bg-primary-900 text-primary-700 dark:text-primary-300' : 'bg-neutral-200 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300'}`}>{d.note}</span>
									)}
									<p class="mt-3">{d.description}</p>
								</CardBody>
							</Card>
						</Col>
					))}
				</Row>
			</Section>
		))
	}

	<Section padding="both">
		<Row>
			<Col span="12" align="center">
				{directOrder && <p class="mx-auto mb-8 max-w-3xl text-lg leading-relaxed" set:html={directOrder} />}
				<Button style="primary" size="lg" link={`${prefix}${distributorCta.buttonLink}`}>
					{distributorCta.buttonText}
				</Button>
			</Col>
		</Row>
	</Section>
</Layout>
